# Aerie · 云栖 v0.3.2-beta.0902-A05 — Environment Variables Example
# Copy this file to `.env` and fill in real values.
# Never commit the real `.env` to git (covered by .gitignore).

# ===== Optional Companion Studio adapter =====
# Companion Studio defaults to http://127.0.0.1:8899; leave blank to keep
# Aerie independent and expose an explicit disabled status.
AERIE_COMPANION_STUDIO_URL=
JUSTONEAPI_TOKEN=
AERIE_ENFORCE_ENTITLEMENTS=0

# ===== OpenAI Ads Measurement Pixel (marketing site only) =====
# Leave disabled until a real Pixel ID and consent policy are approved.
VITE_OPENAI_ADS_PIXEL_ID=
VITE_OPENAI_ADS_MEASUREMENT_ENABLED=false

# ===== AI Providers (LLM) =====
# Primary: Qwen (DashScope, OpenAI-compatible)
DASHSCOPE_API_KEY=your_qwen_api_key_here
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
# 语音转写 ASR 模型（DashScope qwen3-asr-flash，走 compatible-mode chat/completions + input_audio）。
# 不能用 qwen-long（文本模型不支持转写）；DashScope 不提供 /audio/transcriptions 接口。
DASHSCOPE_WHISPER_MODEL=qwen3-asr-flash
# 主链路 QQ 语音转写 ASR 模型（core/qq_media），默认同 qwen3-asr-flash。
DASHSCOPE_ASR_MODEL=qwen3-asr-flash

# ===== Aerie WS（阿里云百炼业务空间专属域名，多 Key 轮询池）=====
# 同一域名下多个 Key 做 RoundRobin 轮询，分摊并发、防止单 Key 额度/并发占满。
AERIE_WS_BASE_URL=https://<workspace-id>.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# 逗号分隔的多个 Key（至少 2 个才有轮询效果）
AERIE_WS_KEYS=sk-ws-xxx,sk-ws-yyy
# 子 Agent / 轻量任务模型（方案：通用子 Agent 用 qwen3.7-flash）
AERIE_WS_MODEL=qwen3.7-flash
# 代码子 Agent + L4 自进化提案生成（缺口 → LLM 生成 file_changes → 四道闸门）
AERIE_WS_CODE_MODEL=kimi-k2.7-code
# 语音转写 ASR 模型
AERIE_WS_ASR_MODEL=qwen3-asr-flash

# Backup: DeepSeek
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Specialized: Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-2.0-flash-exp

# MiniMax (model company)
MINIMAX_API_KEY=your_minimax_api_key_here
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_MODEL=MiniMax-M3

# BigModel / Zhipu GLM
BIGMODEL_API_KEY=your_bigmodel_api_key_here
BIGMODEL_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
BIGMODEL_MODEL=glm-4-plus

# SiliconFlow  (official: api.siliconflow.com, model google/gemma-4-26B-A4B-it)
# Available Gemma models on SiliconFlow:
#   - google/gemma-4-26B-A4B-it  (free, ~1.4s)
#   - google/gemma-4-31B-it      (paid, may be quota-limited)
SILICONFLOW_API_KEY=your_siliconflow_api_key_here
SILICONFLOW_BASE_URL=https://api.siliconflow.com/v1
SILICONFLOW_MODEL=google/gemma-4-26B-A4B-it
# QQ 语音转写 ASR 模型：已切到 DashScope（qwen3-asr-flash），见 DASHSCOPE_ASR_MODEL。
# 原 SiliconFlow 账号无 ASR 模型（SenseVoiceSmall/TeleSpeechASR 均不可用）。
# 轻量模型：用于低延迟、低成本的任务（含错别字订正通道）。
# 默认与现有环境一致指向 Qwen3-30B；如需改用硅基流动上的小米 MiMo 模型，
# 把这里改成你账号里实际可用的小米 id 即可（如 Xiaomi/Xiaomi-MiMo-Air-7B-Instruct）。
SILICONFLOW_LIGHT_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507
# Vision model for the siliconflow-vision skill (optional; default Qwen/Qwen3-VL-8B-Instruct)
# Options: Qwen/Qwen3-VL-235B-A22B-Instruct | Qwen/Qwen2.5-VL-72B-Instruct | glm-4/glm-4.6v
VISION_MODEL=Qwen/Qwen3-VL-8B-Instruct

# OpenAI / GPT  (proxy: api.codexgood.com)
# Available models on this proxy (user-verified 2026-07-16):
#   - gpt-5.5           (validated PASS, 2.33s)
#   - gpt-5.6-luna
#   - gpt-5.6-sol
#   - gpt-5.6-terra
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.codexgood.com/v1
OPENAI_MODEL=gpt-5.5

# ===== Image Generation (gpt-image-2) =====  ← 预置，未来生图模式用
# 接口: POST {IMAGE_GEN_BASE_URL}/images/generations
# 请求头: Authorization: Bearer <key> / Idempotency-Key: <uuid>
# 并发上限: 2
IMAGE_GEN_API_KEY=your_image_gen_api_key_here
IMAGE_GEN_BASE_URL=https://image2.inian.one/v1
IMAGE_GEN_MODEL=gpt-image-2
IMAGE_GEN_ENDPOINT=/images/generations
IMAGE_GEN_CONCURRENCY=2

# ===== Baidu Maps Web Service (百度地图 REST, 替代 MCP) =====
# 用于 world_reality 附近地点/本地活动 + 天气优先源。
# 推荐用 SN 校验模式（填 AK + SK）：百度只验签、不校验来源 IP，
# 软件发给任意用户（任意 IP）都能用，无需维护 IP 白名单。
# 只填 AK 则走 IP 白名单模式（需在控制台登记本机出口 IP）。
# 全部不填时自动回退内置城市数据 + Open-Meteo，开箱即用。
BAIDU_MAP_AK=
BAIDU_MAP_SK=

# ===== Embedding / 专用向量知识库 =====
# 向量知识库 embedding 提供方：
#   - 配置 API Key 走远程 OpenAI 兼容 embedding（推荐生产）
#   - 留空且装好 chromadb 时，回退到 chromadb 本地 ONNX MiniLM 模型
#   - 以上都不可用时，回退到确定性本地哈希向量（离线兜底）
AERIE_EMBEDDING_PROVIDER=openai_compatible
AERIE_EMBEDDING_API_KEY=your_embedding_api_key_here
AERIE_EMBEDDING_BASE_URL=https://api.openai.com/v1
AERIE_EMBEDDING_MODEL=text-embedding-3-small
AERIE_EMBEDDING_TIMEOUT_SECONDS=60
# 向量持久化目录（ChromaDB）
AERIE_CHROMA_DIR=data/chroma
# 知识库集合名
AERIE_KNOWLEDGE_COLLECTION=aerie_knowledge

# ===== QQ / NapCat =====
SELF_QQ=123456789

# Mobile gateway authentication (generate at least 32 random bytes; never commit the value)
AERIE_PRIMARY_USER_ID=
AERIE_MOBILE_TOKEN_PEPPER=
AERIE_MOBILE_AUTH_DB=data/mobile_gateway.db
# Production activation overrides; all shipped capabilities are enabled by default.
# Set an individual flag to false only for a deliberate rollback or incident gate.
AERIE_FEATURE_IDENTITY_CONTRACT_V1=true
AERIE_FEATURE_CONVERSATION_MODEL_V1=true
AERIE_FEATURE_CHAT_REQUEST_QUEUE_V1=true
AERIE_FEATURE_MOBILE_GATEWAY_V1=true
FRIENDS_QQ=987654321,111222333
NAPCAT_WS_URL=ws://127.0.0.1:3001

# ===== HTTP API =====
HTTP_API_HOST=127.0.0.1
HTTP_API_PORT=7890

# ===== Logging =====
LOG_LEVEL=INFO
LOG_DIR=logs

# ===== Diagnostics Telemetry（诊断包上传，可选）=====
# 仅在需要把本地诊断包回传给你（开发者）排查 Bug 时配置。
# 留空 = 只本地打包、不自动上传（默认，推荐）。
# 接收端代码见 tools/telemetry-receiver/（Cloudflare Worker + R2）。
AERIE_TELEMETRY_UPLOAD_URL=
AERIE_TELEMETRY_UPLOAD_TOKEN=

# ===== Information Feeds (brief_fetcher) =====
# 今日热榜 DailyHotApi 聚合端点（news 分层抓取的 aggregator 层）。
# 默认自建 http://127.0.0.1:6688；也可指向任意部署了 DailyHotApi 的实例。
DAILYHOT_API_BASE=http://127.0.0.1:6688
# Bocha 网页搜索（news 最终兜底层，可选；留空则跳过该层）
# BOCHA_API_KEY=your_bocha_api_key_here
