# Aerie · 云栖 v0.1.0-beta.1 — Environment Variables Example
# Copy this file to `.env` and fill in real values.
# Never commit the real `.env` to git (covered by .gitignore).

# ===== AI Providers (LLM) =====
# Primary: Qwen (DashScope, OpenAI-compatible)
DASHSCOPE_API_KEY=your_qwen_api_key_here
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# Backup: DeepSeek
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Specialized: Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-2.0-flash-exp

# MiniMax (model company)
MINIMAX_API_KEY=your_minimax_api_key_here
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_MODEL=MiniMax-M3

# BigModel / Zhipu GLM
BIGMODEL_API_KEY=your_bigmodel_api_key_here
BIGMODEL_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
BIGMODEL_MODEL=glm-4-plus

# SiliconFlow  (official: api.siliconflow.com, model google/gemma-4-26B-A4B-it)
# Available Gemma models on SiliconFlow:
#   - google/gemma-4-26B-A4B-it  (free, ~1.4s)
#   - google/gemma-4-31B-it      (paid, may be quota-limited)
SILICONFLOW_API_KEY=your_siliconflow_api_key_here
SILICONFLOW_BASE_URL=https://api.siliconflow.com/v1
SILICONFLOW_MODEL=google/gemma-4-26B-A4B-it
# Vision model for the siliconflow-vision skill (optional; default Qwen/Qwen3-VL-8B-Instruct)
# Options: Qwen/Qwen3-VL-235B-A22B-Instruct | Qwen/Qwen2.5-VL-72B-Instruct | glm-4/glm-4.6v
VISION_MODEL=Qwen/Qwen3-VL-8B-Instruct

# OpenAI / GPT  (proxy: api.codexgood.com)
# Available models on this proxy (user-verified 2026-07-16):
#   - gpt-5.5           (validated PASS, 2.33s)
#   - gpt-5.6-luna
#   - gpt-5.6-sol
#   - gpt-5.6-terra
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.codexgood.com/v1
OPENAI_MODEL=gpt-5.5

# ===== Image Generation (gpt-image-2) =====  ← 预置，未来生图模式用
# 接口: POST {IMAGE_GEN_BASE_URL}/images/generations
# 请求头: Authorization: Bearer <key> / Idempotency-Key: <uuid>
# 并发上限: 2
IMAGE_GEN_API_KEY=your_image_gen_api_key_here
IMAGE_GEN_BASE_URL=https://image2.inian.one/v1
IMAGE_GEN_MODEL=gpt-image-2
IMAGE_GEN_ENDPOINT=/images/generations
IMAGE_GEN_CONCURRENCY=2

# ===== Baidu Maps Web Service (百度地图 REST, 替代 MCP) =====
# 用于 world_reality 附近地点/本地活动 + 天气优先源。
# 推荐用 SN 校验模式（填 AK + SK）：百度只验签、不校验来源 IP，
# 软件发给任意用户（任意 IP）都能用，无需维护 IP 白名单。
# 只填 AK 则走 IP 白名单模式（需在控制台登记本机出口 IP）。
# 全部不填时自动回退内置城市数据 + Open-Meteo，开箱即用。
BAIDU_MAP_AK=
BAIDU_MAP_SK=

# ===== Embedding / 专用向量知识库 =====
# 向量知识库 embedding 提供方：
#   - 配置 API Key 走远程 OpenAI 兼容 embedding（推荐生产）
#   - 留空且装好 chromadb 时，回退到 chromadb 本地 ONNX MiniLM 模型
#   - 以上都不可用时，回退到确定性本地哈希向量（离线兜底）
AERIE_EMBEDDING_PROVIDER=openai_compatible
AERIE_EMBEDDING_API_KEY=your_embedding_api_key_here
AERIE_EMBEDDING_BASE_URL=https://api.openai.com/v1
AERIE_EMBEDDING_MODEL=text-embedding-3-small
AERIE_EMBEDDING_TIMEOUT_SECONDS=60
# 向量持久化目录（ChromaDB）
AERIE_CHROMA_DIR=data/chroma
# 知识库集合名
AERIE_KNOWLEDGE_COLLECTION=aerie_knowledge

# ===== QQ / NapCat =====
SELF_QQ=123456789

# Mobile gateway authentication (generate at least 32 random bytes; never commit the value)
AERIE_PRIMARY_USER_ID=
AERIE_MOBILE_TOKEN_PEPPER=
AERIE_MOBILE_AUTH_DB=data/mobile_gateway.db
# Production activation overrides; repository feature defaults remain off.
AERIE_FEATURE_IDENTITY_CONTRACT_V1=false
AERIE_FEATURE_CONVERSATION_MODEL_V1=false
AERIE_FEATURE_CHAT_REQUEST_QUEUE_V1=false
AERIE_FEATURE_MOBILE_GATEWAY_V1=false
FRIENDS_QQ=987654321,111222333
NAPCAT_WS_URL=ws://127.0.0.1:3001

# ===== HTTP API =====
HTTP_API_HOST=127.0.0.1
HTTP_API_PORT=7890

# ===== Logging =====
LOG_LEVEL=INFO
LOG_DIR=logs

# ===== Information Feeds (brief_fetcher) =====
# 今日热榜 DailyHotApi 聚合端点（news 分层抓取的 aggregator 层）。
# 默认自建 http://127.0.0.1:6688；也可指向任意部署了 DailyHotApi 的实例。
DAILYHOT_API_BASE=http://127.0.0.1:6688
# Bocha 网页搜索（news 最终兜底层，可选；留空则跳过该层）
# BOCHA_API_KEY=your_bocha_api_key_here
