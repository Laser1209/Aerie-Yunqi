{
  "name": "aerie-companion",
  "productName": "Aerie · 云栖",
  "version": "0.3.1-BETA.0815A4",
  "description": "Aerie - Local-first AI companion with auto-wake proactive messenger",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build:runtime": "python ../scripts/build_python_runtime.py",
    "build:win": "npm run build:runtime && electron-builder --win --x64 && node scripts/post-build-rcedit.js",
    "build:win:alt": "npm run build:runtime && electron-builder --win --x64 --config.directories.output=dist-final && node scripts/post-build-rcedit.js",
    "build:icons": "node scripts/build-icon-sprite.js",
    "check:emojis": "node scripts/check-emojis.js",
    "check:forbidden": "python ../tools/check_forbidden.py",
    "check:tokens": "python ../tools/check_tokens.py",
    "check:all": "npm run check:emojis && npm run check:forbidden && npm run check:tokens",
    "test:unit": "node --test tests/*.test.js",
    "test:e2e": "node tests/e2e/desktop-audit.js",
    "prebuild": "npm run check:emojis && npm run build:icons",
    "lint": "echo 'No JS lint configured'"
  },
  "author": "Laser",
  "license": "UNLICENSED",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.0",
    "playwright-core": "^1.62.0",
    "sharp": "^0.32.6"
  },
  "build": {
    "appId": "com.laser.aerie",
    "productName": "Aerie · 云栖",
    "directories": {
      "output": "dist",
      "buildResources": "builder"
    },
    "files": [
      "src/**/*",
      "builder/icon.ico",
      "builder/icon-1024.png",
      "package.json"
    ],
    "extraResources": [
      { "from": "../Aerie · 云栖.png", "to": "icon.png" },
      { "from": "../.env.example", "to": ".env.example" },
      { "from": "../video", "to": "video" },
      { "from": "runtime-build", "to": "python/runtime" },
      {
        "from": "../",
        "to": "python",
        "filter": [
          "main.py",
          "core/**",
          "config/**",
          "config/relay_preset.env",
          "communication/**",
          "knowledge/**",
          "memory/**",
          "tools/**",
          "voice/**",
          "world_service/**",
          "emotion/**",
          "persona/**",
          "scheduler/**",
          "skills/**",
          "ffmpeg/bin/**",
          ".env.example",
          "!**/__pycache__/**",
          "!**/*.pyc",
          "!**/*.pyo",
          "!data/**",
          "!logs/**"
        ]
      }
    ],
    "win": {
      "icon": "builder/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "requestedExecutionLevel": "requireAdministrator",
      "artifactName": "${productName}-${version}-Setup.${ext}",
      "publisherName": "Laser",
      "signAndEditExecutable": false,
      "verifyUpdateCodeSignature": false
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Aerie · 云栖",
      "include": "builder/installer.nsh"
    }
  }
}
