# Aerie · 云栖 — 预置中转配置（relay preset）
# 这里放的是「中转门卡」和 etta.top 地址，不是真实 API Key。
# 真实 Key 存在 Cloudflare Worker 的环境变量里，永不落地到安装包。
# 门卡泄露了也无需担心：随时在 Cloudflare Worker 里换掉 RELAY_TOKEN 即可。
#
# 打包后后端启动时会兜底加载本文件（不覆盖用户 .env 里已有的值）。

# 阿里云百炼中转（ASR 语音识别 + 子 Agent 共用同一个门卡）
DASHSCOPE_BASE_URL=https://api.etta.top
DASHSCOPE_API_KEY=aerie-kFcCr0zyxq4vo50
AERIE_WS_BASE_URL=https://api.etta.top
AERIE_WS_KEYS=aerie-kFcCr0zyxq4vo50
